# Binary files must never be line-ending normalized — EOL conversion rewrites the bytes, which corrupts
# the file and breaks the byte-exact, hash-keyed compiled-type cache (see docs/drs/automation/caching.md).
# The `binary` macro expands to `-text -diff`: no text conversion, no textual diff.
# Verified by the Test-CheckedInBinaries quality gate (Catzc.Base.ModuleSystem): every tracked file git sees as binary
# must be stored as binary and matched by an explicit `binary` rule here.
#
# Line endings are pinned only where bytes matter (binaries, the C# cache key, the generated root files). There
# is deliberately NO `* text=auto` rule, so existing text files keep their current storage and are not
# mass-renormalized by adding this file. The linguist-* attributes at the end only steer GitHub's language
# statistics and diff display, and the catzc-* attributes declare this repository's own file classes to its
# tools; neither changes any bytes.

# The combined C# types manifest — whole directory, any extension, since it is byte-exact build output.
pwsh/.compiled/** binary

# Binary file types (vendored module assemblies, debug symbols, signatures, native libraries, images, documents,
# archives). *.png also covers the draw.io diagrams (*.drawio.png), whose editable XML rides inside the PNG. *.exe,
# *.so and *.dylib match nothing tracked today: they guard the native binaries a vendored module may ship.
*.dll    binary
*.pdb    binary
*.p7s    binary
*.exe    binary
*.so     binary
*.dylib  binary
*.png    binary
*.pdf    binary
*.gz     binary

# C# type sources are the byte-exact key of the compiled-type cache — their combined hash names the committed
# pwsh/.compiled/Catzc.Types.<hash>.json and the per-machine build. Pin them to LF so every clone/checkout materializes identical
# bytes regardless of core.autocrlf; otherwise a CRLF working tree diverges from the committed manifest and trips
# the loader's "types changed since they were loaded" guard on re-import. See docs/drs/automation/caching.md.
*.cs     text eol=lf

# The committed managed root-config targets (rootconfig.yml committed:true — importer.ps1 and the git files)
# are written canonical-LF by Write-FileIfChanged. Pin them to LF so a core.autocrlf=true machine neither
# warns on every regeneration commit nor checks out CRLF copies that differ from what the writer produced.
# See docs/drs/repository/generated-root-configs.md.
/.gitattributes text eol=lf
/.gitignore     text eol=lf
/importer.ps1   text eol=lf
/pwsh/.internal/assets/Catzc.Types.csproj text eol=lf

# Shell scripts run under bash or zsh, which read a carriage return as part of the command: every shell script is LF
# everywhere, so a Windows checkout runs too (ADR-AUTO-ENGINE: the POSIX engines require LF). This also covers importer.sh.
*.sh            text eol=lf
*.bats          text eol=lf
*.zsh           text eol=lf
# The vendored bats-core test runner: Bash scripts, most without an extension, so they are pinned by folder.
**/.vendor/bats-core/** text eol=lf

# GitHub (linguist): third-party modules are vendored — out of the language statistics. Linguist only knows
# `vendor/`, not this repository's `.vendor/`, so it is named here.
pwsh/.vendor/** linguist-vendored
**/.vendor/bats-core/** linguist-vendored
# Microsoft's dotnet-install scripts, checked in as published: third-party code, so Format-Code leaves them as shipped.
**/assets/scripts/dotnet-install.* linguist-vendored

# GitHub (linguist): committed files the automation writes are generated — out of the statistics, and collapsed
# in pull-request diffs so review lands on their sources (see docs/drs/repository/generated-root-configs.md). The
# lines below the compiled types are rendered from the registries that declare what is generated: the outputs of
# every tracked writer in a module's generated.yml, then every root config rootconfig.yml declares committed.
pwsh/.compiled/** linguist-generated
**/.gitkeep linguist-generated
/pwsh/*/*.psd1 linguist-generated
/pwsh/Tooling.KeyHandler/configs/key-handler-bindings.yml linguist-generated
/infrastructure/templates/*/configuration/**/*.yml linguist-generated
/docs/explanation/flow/.assets/ci-pwsh-to-deploy-apex.drawio.yml linguist-generated
/pwsh/Azure.Templates/assets/cost-prices.json linguist-generated
/python/diagrams/assets/flow/*.svg linguist-generated
/docs/drs/index.md linguist-generated
/docs/drs/glossary.md linguist-generated
/pwsh/Base.Globs/configs/globs/track-sets.yml linguist-generated
/contracts/catzc/0.1.0/*/types.json linguist-generated
/docs/references/contracts/*.md linguist-generated
/docs/**/.assets/*.drawio.png linguist-generated
/pwsh/Base.QualityGates/assets/english.* linguist-generated
/.github/README.md linguist-generated
/docs/explanation/flow/*/.assets/*.png linguist-generated
/docs/explanation/flow/*/.assets/*.slide.png linguist-generated
/importer.ps1 linguist-generated
/importer.sh linguist-generated
/pwsh/.internal/assets/importer-commands.sh linguist-generated
/pwsh/.internal/assets/Catzc.Types.csproj linguist-generated
/nuget.config linguist-generated
/Directory.Build.props linguist-generated
/.gitattributes linguist-generated
/.gitignore linguist-generated

# GitHub (linguist): the Markdown here — the decision records, the explanations, the how-tos, the diagram articles — is authored,
# reviewed and versioned like source, so it counts in the language statistics. Linguist treats Markdown as prose and
# everything under docs/ as documentation, both outside the statistics by default; these two attributes count it in.
# The generated Markdown named above stays out.
*.md linguist-detectable
*.md linguist-documentation=false
# GitHub (linguist): YAML, JSON and XML are "data" and "markup" languages, outside the statistics by default. Here the
# YAML module configs, the azure devops pipelines (.ado/pipelines/, *.yaml), the GitHub workflows (.github/workflows/), the
# JSON, the XML/XSD schemas and the .NET project files are authored and reviewed like source, so they count in. Test
# fixture trees and the frozen contract copies are data or duplicates, so they stay out (the later rules win).
*.yml    linguist-detectable
*.yaml   linguist-detectable
*.json   linguist-detectable
*.xml    linguist-detectable
*.xsd    linguist-detectable
*.csproj linguist-detectable
*.ps1xml linguist-detectable
# Module assets (scripts, templates, schemas, project files) are product, whatever their language: any recognized
# language there counts in, data languages included.
**/assets/** linguist-detectable
**/tests/assets/** linguist-detectable=false
/contracts/** linguist-detectable=false

# GitHub (linguist): the draw.io diagrams are documentation — the pictures the Markdown articles embed. They stay
# binary (the *.png rule above: no line-ending conversion, since the editable XML rides inside the PNG), but their
# diff is switched back on so GitHub renders a changed diagram as an image rather than "binary file not shown";
# git itself still detects the bytes as binary on the command line.
*.drawio.png diff linguist-documentation

# The catzc-* classes below are generated by New-GitAttributes from the `git` entries of the file-kinds registry
# (Catzc.Base.Globs/configs/file-kinds.yml): a kind's globs and its why are written there once, so a class can never
# drift from the kind it restates.
# catzc: contract assets are data on purpose — an asset's bytes are what its contract check compares, so the tools
# that rewrite or check content (links, Markdown titles) leave them as written, and an empty presence asset stays
# empty. They check out with LF on every platform, so a working copy's bytes match the frozen record's hashes
# (ADR-REPO-CONTRACT-RELEASEDIMMUTABLE, ADR-REPO-CONTRACT-CONTRACTASSET).
contracts/*/*/** catzc-contract text eol=lf

# catzc: test fixture trees are data on purpose — the link and Markdown-title tools leave them as written.
**/tests/**/assets/** catzc-fixture

# catzc: files under the unordered track are imports not yet sorted, held to no domain rule until they move — the
# content tools (links, Markdown titles, source conventions) leave them as they landed (DDR-TRACK-UNORDEREDTRACK).
.unordered/** catzc-unordered

# catzc: these files are read verbatim by another tool, so they carry no meta block: every CLAUDE.md is session
# instructions injected as written into a Claude session, the repository landing page is what GitHub renders first, and
# the session settings are parsed by Claude Code (docs/drs/repository/file-meta.md, ADR-REPO-FILEMETA-KINDSCOPE).
**/CLAUDE.md -catzc-meta
/.claude/settings.json -catzc-meta
/.github/README.md -catzc-meta

# catzc: the root-file sources are copied to the repository root under the head Build-RootConfig writes into each copy,
# so a head here would sit beside it with the source's path (docs/drs/repository/file-meta.md, ADR-REPO-FILEMETA-COMPOSEDFILES).
/pwsh/Base.RootConfig/assets/root/** -catzc-meta

# catzc: the .gitkeep source is likewise copied into every .gitkeep under the head Build-GitKeep writes there.
/pwsh/Base.Docs/assets/gitkeep -catzc-meta
