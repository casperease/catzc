{
  "$comment": "The schema of the types surface of the combined catzc types assembly, every public type with its accelerators and display properties, what a consumer binds to and never the build.",
  "type": "object",
  "required": ["types"],
  "properties": {
    "types": {
      "type": "array",
      "items": { "$ref": "#/definitions/type" }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "type": {
      "type": "object",
      "required": ["name", "aliases", "display"],
      "properties": {
        "name": { "type": "string", "pattern": "^Catzc(\\.[A-Za-z0-9_]+)+$" },
        "aliases": { "type": "array", "items": { "type": "string" } },
        "display": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
