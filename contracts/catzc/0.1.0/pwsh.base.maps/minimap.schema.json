{
  "$comment": "The schema of one minimap's data, the axes and cells the maps module writes and the diagram kit draws, every lit cell with its reason.",
  "type": "object",
  "required": ["id", "axes", "cells", "lit"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "enum": [
        "grid",
        "code-locations",
        "axis",
        "layer-stack",
        "lifecycle-position",
        "track-placement",
        "engine-strip",
        "module-neighbourhood"
      ]
    },
    "axes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "values"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "values": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "count"],
        "additionalProperties": false,
        "properties": {
          "at": { "type": "array", "items": { "type": "string" } },
          "count": { "type": "integer" }
        }
      }
    },
    "place_rows": {
      "type": "object",
      "required": ["rows", "counters"],
      "additionalProperties": false,
      "properties": {
        "rows": { "type": "array", "items": { "type": "string" } },
        "counters": { "type": "string" }
      }
    },
    "lit": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "count", "reasons"],
        "additionalProperties": false,
        "properties": {
          "at": { "type": "array", "items": { "type": "string" } },
          "count": { "type": "integer" },
          "reasons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["subject", "basis", "requested", "note"],
              "additionalProperties": false,
              "properties": {
                "subject": { "type": ["string", "null"] },
                "basis": { "type": "string" },
                "requested": { "type": ["string", "null"] },
                "note": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
