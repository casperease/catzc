{
  "$comment": "The schema of the query rows a C3, C4 or flow slide is drawn from, one row per point with its edges, and its level and nodes or its flow lens and lanes.",
  "type": "object",
  "required": ["rows"],
  "additionalProperties": false,
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["point", "edges"],
        "additionalProperties": false,
        "properties": {
          "point": { "type": "string" },
          "level": { "type": "string", "enum": ["C3", "C4"] },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "kind"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "kind": { "type": "string" }
              }
            }
          },
          "lens": { "type": "string", "enum": ["flow"] },
          "lanes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "unit", "engine", "triggers", "review", "templates", "environments"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string" },
                "unit": { "type": "string" },
                "engine": { "type": "string" },
                "triggers": { "type": "array", "items": { "type": "string" } },
                "review": { "type": "boolean" },
                "templates": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "kind"],
                    "additionalProperties": false,
                    "properties": { "name": { "type": "string" }, "kind": { "type": "string" } }
                  }
                },
                "environments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "rung", "gate", "approve"],
                    "additionalProperties": false,
                    "properties": {
                      "id": { "type": "string" },
                      "rung": { "type": "string" },
                      "gate": { "type": "string" },
                      "approve": { "type": "boolean" }
                    }
                  }
                }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["from", "to"],
              "additionalProperties": false,
              "properties": {
                "from": { "type": "string" },
                "to": { "type": "string" },
                "label": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
