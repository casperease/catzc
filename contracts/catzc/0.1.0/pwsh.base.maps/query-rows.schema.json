{
  "$comment": "The schema of the query rows a C3 or C4 slide is drawn from, one row per level and point of the tree with its nodes and the edges between them.",
  "type": "object",
  "required": ["rows"],
  "additionalProperties": false,
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["point", "level", "nodes", "edges"],
        "additionalProperties": false,
        "properties": {
          "point": { "type": "string" },
          "level": { "type": "string", "enum": ["C3", "C4"] },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "kind"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "kind": { "type": "string" }
              }
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["from", "to"],
              "additionalProperties": false,
              "properties": {
                "from": { "type": "string" },
                "to": { "type": "string" },
                "label": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
