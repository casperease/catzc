{
  "$comment": "Provided schema of a file's meta head, validated against the sample beside it (ADR-REPO-CONTRACT-CONTRACTASSET): the keys of catzc.immutable (the place facts) and catzc.edges (the outgoing edges), which a tool may rely on. A fact a file has no value for is left out, so only path and role are required. The role is the name of the file-kinds entry that selects the file; the kind of the object the file belongs to is its track's type, tracktype.",
  "type": "object",
  "required": ["catzc"],
  "additionalProperties": false,
  "properties": {
    "catzc": {
      "type": "object",
      "required": ["immutable"],
      "additionalProperties": false,
      "properties": {
        "config": { "type": "object" },
        "immutable": {
          "type": "object",
          "required": ["path", "role"],
          "additionalProperties": false,
          "properties": {
            "with_body_sha": { "type": "string" },
            "with_inputs_sha": { "type": "string" },
            "repo_status": { "type": "string", "enum": ["clean", "locked"] },
            "path": { "type": "string" },
            "folder": { "type": "string" },
            "name": { "type": "string" },
            "source": { "type": "string" },
            "role": { "type": "string" },
            "subkind": { "type": "string" },
            "language": { "type": "string" },
            "filetype": { "type": "string" },
            "track": { "type": "string" },
            "tracktype": { "type": "string" },
            "vendor": { "type": "string" },
            "module": { "type": "string" },
            "moduletype": { "type": "string" },
            "catzc_bundle": { "type": "string" },
            "generator": { "type": "string" },
            "visibility": { "type": "string", "enum": ["public", "private"] }
          }
        },
        "edges": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "defines": { "type": "array", "items": { "type": "string" } },
            "cites": { "type": "array", "items": { "type": "string" } },
            "links": { "type": "array", "items": { "type": "string" } },
            "page": { "type": "string" },
            "test": { "type": "string" }
          }
        }
      }
    }
  }
}
