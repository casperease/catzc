{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Agent(*)",
      "Skill(*)",
      "NotebookEdit(*)",
      "Bash(sed 's|^| |')",
      "Bash(psd1)",
      "Bash(psm1\")",
      "Bash(pwsh -NoProfile -File out/:*)",
      "Bash(pwsh -NoProfile -File out/*)",
      "Bash(bash out/:*)"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git stash:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git tag:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git remote:*)",
      "Bash(git clean:*)",
      "Bash(git restore:*)",
      "Bash(git switch:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "p=\"$CLAUDE_PROJECT_DIR/.claude/hooks/bin/Assert-BashTimeout\"; command -v \"$p\" >/dev/null || { echo \"Bash time safeguard is not built: import the repository (Build-BashTimeoutHook publishes it).\" >&2; exit 1; }; exec \"$p\"",
            "timeout": 10,
            "statusMessage": "Checking the Bash time safeguard"
          }
        ]
      }
    ]
  }
}
