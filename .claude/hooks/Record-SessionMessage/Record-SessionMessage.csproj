<!--
  The Claude Code hook that appends every cross-session message a session sends or receives to the day's orchestrator log (Program.cs).
  Build-AgentHook publishes it, framework-dependent, to .claude/hooks/bin/ whenever its sources change; obj/bin here and the published
  output are gitignored. It reads only the hook input, so it links no module source.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The one configuration and platform of bcl.yml
        ([ADR-BCL-TYPES-DEBUGANYCPU](/docs/drs/automation/BCL/native-csharp-types.md#rule-adr-bcl-types-debuganycpu)). -->
    <Configurations>Debug</Configurations>
    <Platforms>AnyCPU</Platforms>
    <AssemblyName>Record-SessionMessage</AssemblyName>
    <RootNamespace>Catzc.Hooks</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseAppHost>true</UseAppHost>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
