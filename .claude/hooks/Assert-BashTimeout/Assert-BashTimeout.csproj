<!--
  The Claude Code Bash time-safeguard hook (Program.cs). Build-AgentHook publishes it, framework-dependent,
  to .claude/hooks/bin/ whenever its sources change — this folder's files and every linked <Compile> source below;
  obj/bin here and the published output are gitignored.

  The modules folder is the CatzcModulesFolder property Build-AgentHook passes, so the project names no folder.

  The decision and the limits are the Catzc.Base.Timeouts module's own types, compiled in from their source files,
  so the hook can never drift from Get-TimeoutSeconds. YAML is read with the YamlDotNet the vendored powershell-yaml
  module ships, so the build needs no package download.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The one configuration and platform of bcl.yml
        ([ADR-BCL-TYPES-DEBUGANYCPU](/docs/adr/automation/BCL/native-csharp-types.md#rule-adr-bcl-types-debuganycpu)). -->
    <Configurations>Debug</Configurations>
    <Platforms>AnyCPU</Platforms>
    <AssemblyName>Assert-BashTimeout</AssemblyName>
    <RootNamespace>Catzc.Hooks</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseAppHost>true</UseAppHost>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../$(CatzcModulesFolder)/Catzc.Base.Objects/types/DictionaryRecord.cs" Link="linked/DictionaryRecord.cs" />
    <Compile Include="../../../$(CatzcModulesFolder)/Catzc.Base.Objects/types/ConsoleText.cs" Link="linked/ConsoleText.cs" />
    <Compile Include="../../../$(CatzcModulesFolder)/Catzc.Base.Objects/types/ConsoleDisplayAttribute.cs" Link="linked/ConsoleDisplayAttribute.cs" />
    <Compile Include="../../../$(CatzcModulesFolder)/Catzc.Base.Objects/types/TypeShape.cs" Link="linked/TypeShape.cs" />
    <Compile Include="../../../$(CatzcModulesFolder)/Catzc.Base.Engines/types/ExecutionEngine.cs" Link="linked/ExecutionEngine.cs" />
    <Compile Include="../../../$(CatzcModulesFolder)/Catzc.Base.Engines/types/ExecutionEngines.cs" Link="linked/ExecutionEngines.cs" />
    <Compile Include="../../../$(CatzcModulesFolder)/Catzc.Base.Timeouts/types/TimeoutsConfig.cs" Link="linked/TimeoutsConfig.cs" />
    <Compile Include="../../../$(CatzcModulesFolder)/Catzc.Base.Timeouts/types/TestTiers.cs" Link="linked/TestTiers.cs" />
    <Compile Include="../../../$(CatzcModulesFolder)/Catzc.Base.Timeouts/types/BashSafeguard.cs" Link="linked/BashSafeguard.cs" />
    <Compile Include="../../../$(CatzcModulesFolder)/Catzc.Base.Timeouts/types/BoundedCommand.cs" Link="linked/BoundedCommand.cs" />
    <Compile Include="../../../$(CatzcModulesFolder)/Catzc.Base.Git/types/GitFlowConfig.cs" Link="linked/GitFlowConfig.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="YamlDotNet">
      <HintPath>../../../$(CatzcModulesFolder)/.vendor/powershell-yaml/0.4.12/lib/netstandard2.1/YamlDotNet.dll</HintPath>
    </Reference>
  </ItemGroup>
  <Target Name="RequireCatzcModulesFolder" BeforeTargets="BeforeBuild" Condition="'$(CatzcModulesFolder)' == ''">
    <Error Text="CatzcModulesFolder is not set: build the hook with Build-AgentHook, which passes the modules folder from Get-CatzcModulesFolder." />
  </Target>
</Project>
