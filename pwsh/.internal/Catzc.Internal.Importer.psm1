Set-StrictMode -Version Latest   # this module's scope: every function here runs strict

$script:modulesFolder = 'pwsh'

function Invoke-Importer {
    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSAvoidUsingWriteHost', '', Justification = 'Importer console output runs before the module system (Write-Message) is available')]
    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSAvoidGlobalVars', '', Justification = 'Session-global by design: $global:__CatzcLoadTimings is the cross-module load-timing collector created here under -DiagnoseLoadTime, appended to by the Bootstrap loaders across module imports, and summarized at the end — it must be global to survive across those imports (Bootstrap.psm1 carries the same suppression)')]
    [CmdletBinding()]
    param(
        [switch] $ExportPrivates,
        [switch] $AllowWarnings,
        [switch] $DiagnoseLoadTime,

        [switch] $ClearCompiledTypes,

        [switch] $SkipJanitors,

        [switch] $CleanClone,

        [switch] $Bundle,

        [string[]] $Languages,

        [string[]] $Engines
    )

    if ($PSVersionTable.PSVersion -lt [version]'7.4') {
        throw "The Catzc toolset requires PowerShell 7.4 or later (found $($PSVersionTable.PSVersion))."
    }

    # Strict mode
    Set-StrictMode -Version Latest

    $stack = Get-PSCallStack
    $callerScriptName = if ($stack.Count -gt 2) {
        $stack[2].ScriptName
    }
    else {
        $null
    }
    $isConsoleSession = [string]::IsNullOrEmpty($callerScriptName)

    if ($isConsoleSession) {
        $sw = [Diagnostics.Stopwatch]::StartNew()
    }
    if ($DiagnoseLoadTime) {
        $script:diagSw = [Diagnostics.Stopwatch]::StartNew()
        # Collectors the Bootstrap loaders (incl. Import-CSharpTypes) append to, summarized at the end.
        $global:__CatzcLoadTimings = [System.Collections.Generic.List[object]]::new()
    }

    $showStateChanges = $VerbosePreference -ne 'SilentlyContinue'
    $callerVerbosePreference = $global:VerbosePreference
    $global:VerbosePreference = 'SilentlyContinue'
    try {
        # Configuration
        $vendorFolder = '.vendor'

        # Global error handling — fail fast on errors and warnings by default
        $global:ErrorActionPreference = 'Stop'
        $global:WarningPreference = if ($AllowWarnings) {
            'Continue'
        }
        else {
            'Stop'
        }
        $global:InformationPreference = 'Continue'

        $outputEncodingChanged = Set-RedirectedOutputEncoding

        $repoRoot = $env:RepositoryRoot
        Write-Verbose "RepositoryRoot: $repoRoot"

        if ($Bundle -and $env:CatzcModulesRoot) {
            $modulesRoot = $env:CatzcModulesRoot
        }
        else {
            $modulesRoot = Join-Path $repoRoot $script:modulesFolder
        }
        $env:CatzcModulesRoot = $modulesRoot
        Write-Verbose "CatzcModulesRoot: $modulesRoot"

        # A bundle is a read-only install with no git work tree: never run the tree/git-mutating janitors.
        if ($Bundle) {
            $SkipJanitors = $true
        }

        Import-InternalModule Bootstrap -Force
        Import-InternalModule Types -Force
        Import-InternalModule Vendor -Force
        # Hand the setting to the bootstrap writer, which the vendor and bootstrap module functions announce through.
        Set-ImporterVerbosity -Enabled $showStateChanges
        if ($DiagnoseLoadTime) {
            Write-LoadTime 'Bootstrap and internal shared modules loaded'
        }

        # Custom error view — shows ScriptStackTrace for unhandled errors
        $errorViewPath = Join-Path $modulesRoot '.internal/assets/ErrorView.format.ps1xml'
        Update-FormatData -PrependPath $errorViewPath

        Write-ImporterMessage ("Session: ErrorActionPreference=$global:ErrorActionPreference, WarningPreference=$global:WarningPreference, " +
            "InformationPreference=$global:InformationPreference, error view '$errorViewPath'") -StateChange
        if ($outputEncodingChanged) {
            Write-ImporterMessage 'Session: console output encoding UTF-8 (output is redirected)' -StateChange
        }
        Write-ImporterMessage ("Roots: RepositoryRoot='$repoRoot', CatzcModulesRoot='$modulesRoot'; " +
            'internal modules Catzc.Internal.Loader, Catzc.Internal.Types, Catzc.Internal.Vendor') -StateChange

        # Load vendored dependencies first
        if ($isConsoleSession) {
            $initializerEnd = $sw.Elapsed
        }
        $vendorRoot = Join-Path $modulesRoot $vendorFolder
        Write-Verbose "Loading vendor modules from: $vendorRoot"
        Import-VendorModules -VendorRoot $vendorRoot -Lazy 'Pester', 'PSScriptAnalyzer' -DiagnoseLoadTime:$DiagnoseLoadTime
        if ($DiagnoseLoadTime) {
            Write-LoadTime 'Vendor modules loaded'
        }

        if ($ClearCompiledTypes) {
            Clear-CompiledType -ModulesRoot $modulesRoot
        }

        Write-Verbose "Discovering modules in: $modulesRoot"
        # An interactive dot-source is the only console host; a script, a test worker, a -File or -Command process and a pipeline load the types and run the janitors at import.
        $hostKind = if ($isConsoleSession -and (Test-IsInteractiveHost) -and -not (Test-IsRunningInPipeline)) {
            'console'
        }
        else {
            'headless'
        }
        Import-AllModules -ModulesRoot $modulesRoot -ExportPrivates:$ExportPrivates -DiagnoseLoadTime:$DiagnoseLoadTime -Bundle:$Bundle -HostKind $hostKind
        if ($isConsoleSession) {
            $finalizerStart = $sw.Elapsed
        }
        Assert-CatzcRunModeExclusive -ModulesRoot $modulesRoot

        if ($Bundle) {
            Invoke-ConsumerOverlay -RepositoryRoot $repoRoot
        }
        if ($DiagnoseLoadTime) {
            Write-LoadTime 'All modules loaded'
        }

        # The mix is resolved once the modules are loaded and kept as the session record; the modules outside it are removed.
        $mixArgs = @{}
        foreach ($axis in 'Languages', 'Engines') {
            if ($PSBoundParameters.ContainsKey($axis)) {
                $mixArgs[$axis] = $PSBoundParameters[$axis]
            }
        }
        $setImportMix = Get-Command Set-ImportMix -ErrorAction Ignore
        if (-not $setImportMix -and $mixArgs.Count -gt 0) {
            throw "The importer was given -$(@($mixArgs.Keys) -join ' and -'), but this toolset does not carry Catzc.Base.ModuleSystem, which decides the mix."
        }
        $deferMix = $setImportMix -and $hostKind -eq 'console' -and $mixArgs.Count -eq 0
        if ($setImportMix -and -not $deferMix) {
            [void] (& $setImportMix @mixArgs)
            if ($DiagnoseLoadTime) {
                Write-LoadTime 'Import mix resolved'
            }
        }

        if ($DiagnoseLoadTime) {
            Write-LoadTimeSummary
        }

        $deferJanitors = -not $SkipJanitors -and $hostKind -eq 'console' -and -not $CleanClone
        if ($deferMix) {
            # A console import stays types-free: the mix needs the types, so it is resolved once the first prompt has shown, before the janitors.
            $show = $showStateChanges
            Enable-DeferredJanitors -Action {
                [void] (Set-ImportMix)
                if ($deferJanitors) {
                    Import-InternalModule Importer -Force
                    try {
                        & (Get-Module Catzc.Internal.Importer) { param($showStateChanges) Invoke-ImporterJanitors -ShowStateChanges:$showStateChanges } $show
                    }
                    finally {
                        Remove-Module Catzc.Internal.Importer -Force -ErrorAction SilentlyContinue
                    }
                }
            }.GetNewClosure()
            Write-Verbose 'Import mix deferred until the first prompt has shown'
        }
        elseif ($deferJanitors) {
            # A console import stays types-free: the janitors call catzc commands, so they run once the first prompt has shown.
            Enable-DeferredJanitors -ShowStateChanges:$showStateChanges
            Write-Verbose 'Janitors deferred until the first prompt has shown'
        }
        if (-not $SkipJanitors -and -not $deferJanitors) {
            Invoke-ImporterJanitors -CleanClone:$CleanClone -ShowStateChanges:$showStateChanges
        }

        if (-not $SkipJanitors -and $IsWindows) {
            $hasUncModulePath = ($env:PSModulePath -split [IO.Path]::PathSeparator) -match '^\\\\' | Select-Object -First 1

            if ($hasUncModulePath) {
                $fixScript = Join-Path $modulesRoot 'Catzc.Base.Environment/assets/Set-LocalPsModulePath.ps1'
                Write-ImporterMessage ''
                Write-ImporterMessage 'WARNING: PSModulePath contains a network share.' -ForegroundColor Yellow
                Write-ImporterMessage 'PowerShell will be slow — module lookups scan the network.' -ForegroundColor Yellow
                Write-ImporterMessage 'Run this once to fix:' -ForegroundColor Yellow
                Write-ImporterMessage "  & '$fixScript'" -ForegroundColor Cyan
                Write-ImporterMessage ''
            }
        }

        Write-Verbose 'Removing Catzc.Internal.Bootstrap module'
        Remove-Module Catzc.Internal.Bootstrap -Force -ErrorAction SilentlyContinue -Verbose:$false

        if ($isConsoleSession) {
            $writeMessage = Get-Command Write-Message -ErrorAction Ignore
            if ($writeMessage) {
                $totalSeconds = [math]::Round($sw.Elapsed.TotalSeconds, 1)
                $initializerSeconds = [math]::Round($initializerEnd.TotalSeconds, 1)
                $importSeconds = [math]::Round(($finalizerStart - $initializerEnd).TotalSeconds, 1)
                $finalizerSeconds = [math]::Round(($sw.Elapsed - $finalizerStart).TotalSeconds, 1)
                # Run through its command info: a lookup by name is a first use and would load the pending types for a status line.
                & $writeMessage "Loaded in $totalSeconds seconds (session initializer ${initializerSeconds}s, module import ${importSeconds}s, session finalizer ${finalizerSeconds}s)"
            }
        }
    }
    finally {
        $global:VerbosePreference = $callerVerbosePreference
    }
}

function Invoke-ConsumerOverlay {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $RepositoryRoot
    )

    if (-not [System.IO.Directory]::Exists([System.IO.Path]::Combine($RepositoryRoot, '.catzc', $script:modulesFolder))) {
        return
    }
    if (-not (Get-Command Import-CatzcOverlay -ErrorAction Ignore)) {
        throw "The working root '$RepositoryRoot' has a consumer overlay (.catzc/$($script:modulesFolder)/), but this bundle does not carry Catzc.Base.Overlay, which applies it. Use a bundle whose profile includes Catzc.Base.Overlay, or remove the overlay."
    }
    $applied = @(Import-CatzcOverlay)
    $overrides = @($applied | Where-Object { $_.Kind -eq 'FunctionOverride' }).Count
    $locals = @($applied | Where-Object { $_.Kind -eq 'LocalModule' }).Count
    if ($applied.Count -gt 0) {
        Write-ImporterMessage "Overlay: $overrides function override(s) applied, $locals local module(s) loaded from .catzc/$($script:modulesFolder)" -StateChange
    }
}

function Assert-CatzcRunModeExclusive {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $ModulesRoot
    )

    $offenders = @(Get-ForeignCatzcModule -ModulesRoot $ModulesRoot -IncludeInternal)
    if ($offenders.Count -eq 0) {
        return
    }

    $otherRoots = [System.Collections.Generic.List[string]]::new()
    $lines = foreach ($module in $offenders) {
        $otherRoot = [System.IO.Path]::GetDirectoryName($module.ModuleBase)
        if (-not $otherRoots.Contains($otherRoot)) {
            $otherRoots.Add($otherRoot)
        }
        "  $($module.Name) ($($module.ModuleBase))"
    }
    $header = "Run-mode exclusivity violated: the active CatzcModulesRoot is '$ModulesRoot', but $($offenders.Count) loaded catzc module(s) come from another root ('$($otherRoots -join "', '")'):"
    $footer = 'Restart PowerShell, or re-run the entry script of the mode you want.'
    throw ((@($header) + @($lines) + @($footer)) -join "`n")
}

function Set-RedirectedOutputEncoding {
    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('Measure-NoRawConsoleWrite', '', Justification = 'The one sanctioned console-property assignment (ADR-PWSH-ANNOUNCE-INFORMATIONSTREAMCHOKEPOINT): UTF-8 output for a redirected session, announced by Invoke-Importer on its load record.')]
    [CmdletBinding()]
    [OutputType([bool])]
    param()

    if (-not [Console]::IsOutputRedirected -or [Console]::OutputEncoding.CodePage -eq 65001) {
        return $false
    }
    [Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false)
    $true
}

function Invoke-TypeCacheJanitor {
    [CmdletBinding()]
    param(
        [switch] $ShowReport
    )

    if (-not (Get-Command Clear-ModuleTypeCache -ErrorAction Ignore)) {
        return
    }
    try {
        Clear-ModuleTypeCache -Silent:(-not $ShowReport)
    }
    catch {
        Write-ImporterMessage $_.Exception.Message -ForegroundColor Red
    }
}

# The one line a janitor prints instead of working inside VS Code: what it left undone and the command to run from a terminal outside the editor.
function Write-InsideVsCodeNotice {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string] $Subject,

        [Parameter(Mandatory)]
        [string] $State,

        [Parameter(Mandatory)]
        [string] $Command
    )

    Write-ImporterMessage "${Subject}: $State from inside VS Code — run $Command from a terminal outside the editor." -ForegroundColor Yellow
}

function Invoke-AgentHookJanitor {
    [CmdletBinding()]
    param()

    if (-not (Get-Command Build-AgentHook -ErrorAction Ignore) -or (Get-SessionActor) -eq 'Pipeline' -or
        -not (Test-Path -LiteralPath (Join-Path $env:RepositoryRoot '.claude/hooks'))) {
        return
    }
    if (Test-IsRunningInVsCode) {
        try {
            $stale = @(Build-AgentHook -ListStale)
            if ($stale.Count -gt 0) {
                Write-InsideVsCodeNotice -Subject 'Agent hooks' -State "$($stale -join ', ') stale, not built" -Command 'Build-AgentHook'
            }
        }
        catch {
            Write-ImporterMessage "Agent hooks: not checked — $($_.Exception.Message)" -ForegroundColor Yellow
        }
        return
    }
    if (-not (Get-Command dotnet -ErrorAction Ignore)) {
        Write-ImporterMessage 'Agent hooks: not built — dotnet is not on PATH (Install-Dotnet).' -ForegroundColor Yellow
        return
    }
    try {
        $null = Build-AgentHook
    }
    catch {
        Write-ImporterMessage "Agent hooks: not all were published — $($_.Exception.Message)" -ForegroundColor Red
    }
}

# Installs the repository's own editor extensions whose installed copy is missing or stale, so loading the repo is the whole setup.
function Invoke-EditorExtensionJanitor {
    [CmdletBinding()]
    param()

    if (-not (Get-Command Install-VsCodeExtension -ErrorAction Ignore) -or (Get-SessionActor) -eq 'Pipeline' -or
        -not (Get-Command code -ErrorAction Ignore)) {
        return
    }
    if (Test-IsRunningInVsCode) {
        Write-InsideVsCodeNotice -Subject 'Editor extensions' -State 'not installed' -Command 'Install-VsCodeExtension'
        return
    }
    try {
        foreach ($packagePath in @(Install-VsCodeExtension)) {
            Write-ImporterMessage "Editor extension installed: $(Split-Path $packagePath -Leaf) — reload the VS Code window to load it." -ForegroundColor Yellow
        }
    }
    catch {
        Write-ImporterMessage "Editor extensions were not installed — $($_.Exception.Message)" -ForegroundColor Red
    }
}

# Checks the stamp of every changed generated file: one line per stale file, one line when the roof stops it.
function Invoke-GeneratedFilesJanitor {
    [CmdletBinding()]
    param()

    if (-not (Get-Command Test-GeneratedFiles -ErrorAction Ignore) -or (Get-SessionActor) -eq 'Pipeline') {
        return
    }
    try {
        $seconds = (Get-Config -Config timeouts).janitors['generated_files_seconds']
        $result = Invoke-WithTimeout -Seconds $seconds -Activity 'Test-GeneratedFiles -Changed -StampOnly' {
            Test-GeneratedFiles -Changed -StampOnly -PassThru 6>$null
        }
        foreach ($issue in @($result.Issues)) {
            Write-ImporterMessage "Generated file: $issue" -ForegroundColor Yellow
        }
    }
    catch {
        Write-ImporterMessage "Generated files: not checked — $($_.Exception.Message)" -ForegroundColor Yellow
    }
}

# The writers' due rows (Get-GeneratedWriterDue), or nothing when they cannot be read: every build janitor then runs, as before the lists.
function Get-DueWriterRow {
    [CmdletBinding()]
    param()

    if (-not (Get-Command Get-GeneratedWriterDue -ErrorAction Ignore)) {
        return
    }
    try {
        Get-GeneratedWriterDue
    }
    catch {
        Write-ImporterMessage "Build janitors: all run, the changed set was not read — $($_.Exception.Message)" -ForegroundColor Yellow
    }
}

function Test-WriterDue {
    [CmdletBinding()]
    [OutputType([bool])]
    param(
        [Parameter(Mandatory)]
        [string] $Name,

        [AllowNull()]
        [object[]] $Row
    )

    $found = @($Row | Where-Object { $null -ne $_ -and $_.Name -ceq $Name })
    # A writer with no row, or none declaring lists, runs as it always has.
    if ($found.Count -eq 0 -or -not $found[0].HasLists) {
        return $true
    }
    [bool] $found[0].Due
}

function Invoke-ImporterJanitors {
    [CmdletBinding()]
    param(
        [switch] $CleanClone,
        [switch] $ShowStateChanges
    )

    if ($CleanClone -and (Get-Command Reset-GitCleanFxd -ErrorAction Ignore)) {
        Reset-GitCleanFxd
    }

    # Before the re-renders, so a hand edit is reported before a render overwrites it.
    Invoke-GeneratedFilesJanitor

    # Tidy superseded type assemblies (.compiled stays a clean -1/+1 diff) — see Invoke-TypeCacheJanitor.
    Invoke-TypeCacheJanitor -ShowReport:$ShowStateChanges

    $due = Get-DueWriterRow
    $atImport = @(if (Get-Command Get-Config -ErrorAction Ignore) {
            (Get-Config -Config generated-files).writers.Values | Where-Object { $_.at_import } | ForEach-Object { $_.name }
        })
    $gates = Get-Module Catzc.Base.QualityGates
    foreach ($writer in $atImport) {
        if ((Get-Command $writer -ErrorAction Ignore) -and (Test-WriterDue -Name $writer -Row $due)) {
            & $writer -Silent | Out-Null
            # The writer ran: its input stamp is stored, so it is not due again until one of its inputs changes.
            if ($gates) {
                & $gates { param($name) Save-GeneratedWriterStamp -Name $name } $writer
            }
        }
    }

    if (Get-Command Sync-SessionTools -ErrorAction Ignore) {
        $informationPreference = $global:InformationPreference
        if (-not $ShowStateChanges) {
            $global:InformationPreference = 'SilentlyContinue'
        }
        try {
            Sync-SessionTools
        }
        finally {
            $global:InformationPreference = $informationPreference
        }
    }

    # Publish the agent hook when its source changed — after the PATH reconciliation, so `dotnet` is the owned SDK.
    Invoke-AgentHookJanitor

    Invoke-EditorExtensionJanitor
}

function Write-LoadTime {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory, Position = 0)]
        [string] $Step
    )

    if ($null -eq $ExecutionContext.SessionState.PSVariable.GetValue('script:diagSw')) {
        $script:diagSw = [Diagnostics.Stopwatch]::StartNew()
    }
    Write-ImporterMessage ('{0,6}ms  {1}' -f [int]$script:diagSw.Elapsed.TotalMilliseconds, $Step) -ForegroundColor DarkGray
    $script:diagSw.Restart()
}

function Write-LoadTimeSummary {
    [Diagnostics.CodeAnalysis.SuppressMessageAttribute('PSAvoidGlobalVars', '', Justification = 'Reads $global:__CatzcLoadTimings, the cross-module load-timing collector Invoke-Importer creates under -DiagnoseLoadTime')]
    [CmdletBinding()]
    param()

    Write-ImporterMessage '  ---- summary ----' -ForegroundColor DarkGray

    $scanMs = [int](($global:__CatzcLoadTimings | Measure-Object ReadMs -Sum).Sum)
    $scanFiles = [int](($global:__CatzcLoadTimings | Measure-Object FileCount -Sum).Sum)
    $parseMs = [int](($global:__CatzcLoadTimings | Measure-Object ImportMs -Sum).Sum)
    Write-ImporterMessage ('  file-read I/O (cold; warm-cached after 1st access): {0}ms across {1} .ps1 files' -f $scanMs, $scanFiles) -ForegroundColor DarkGray
    Write-ImporterMessage ('  Import-Module parse/compile (incl. any AV/AMSI scan-on-parse): {0}ms' -f $parseMs) -ForegroundColor DarkGray
    $top = $global:__CatzcLoadTimings | Sort-Object Ms -Descending | Select-Object -First 3
    foreach ($t in $top) {
        Write-ImporterMessage ('  slowest: {0,6}ms  {1}' -f $t.Ms, $t.Stage) -ForegroundColor DarkGray
    }
}

Export-ModuleMember -Function Invoke-Importer
