<!--
  IDE: It exists so VS Code's C# Dev Kit (and any Roslyn-based editor) compiles and analyzes
  the repo's native type sources — pwsh/<Module>/types/*.cs — with the SAME rules the runtime honors.

  Location: this project lives at pwsh/.internal/assets/Catzc.Types.csproj; the root catzc.sln (a real
  solution, managed by Build-RootConfig and kept at the repo root so Dev Kit auto-loads it) references it by
  relative path. Every
  path below is therefore project-relative: '../..' is the pwsh/ directory.
  Each source declares its module's file-scoped namespace (Format-Types writes it, Test-Formatting checks it), so
  the analyzer sees real namespaces and never raises a false CA1050 "Declare types in namespaces".

  At import time Import-CSharpTypes compiles the very same sources with
  Add-Type into one committed assembly (pwsh/.compiled/Catzc.Types.<hash>.dll); nothing here is shipped
  or required to run the toolset. The project's only job is to make the editor's feedback equal the runtime's
  — everything-as-code. To stay faithful, it mirrors Add-Type's compile: Nullable and ImplicitUsings OFF (the
  runtime enables neither). Build output (obj/, bin/) is gitignored. See ADR native-csharp-types (code types).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="catzc">
    <CatzcMeta><![CDATA[catzc:
  immutable:
    with_body_sha: "9fe9a182875e"
    warning: "Do Not Edit, this file is generated"
    role: asset
    track: pwsh
    generator: pwsh/Catzc.Base.RootConfig/Build-RootConfig.ps1
    source: pwsh/Catzc.Base.TypesSystem/assets/Catzc.Types.csproj.xml]]></CatzcMeta>
  </PropertyGroup>

  <PropertyGroup>
    <!-- The runtime host (PowerShell 7.6) runs on .NET 10, the framework Add-Type compiles these against. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- The one configuration and platform of bcl.yml (ADR-AUTO-TYPES-DEBUGANYCPU). -->
    <Configurations>Debug</Configurations>
    <Platforms>AnyCPU</Platforms>
    <!-- Mirror Add-Type: it compiles with neither a nullable context nor implicit usings, so neither here —
         otherwise the editor would flag (or silence) things the runtime compile never sees. -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Hand-list the sources below instead of the SDK's default '**/*.cs' glob, so the project never tries to
         compile its own build intermediates or any future non-type .cs. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Broadest glob: every .cs in pwsh/ is a type source today (all under a module's types/ folder).
         Project-relative ('../..' = pwsh/). Tighten to '../../*/types/*.cs' only if a non-type .cs is
         ever added. -->
    <Compile Include="../../**/types/*.cs" />
  </ItemGroup>

  <!--
    Reference System.Management.Automation from the pwsh HOST, not a package. The runtime compile
    (Add-Type) gets SMA for free — it is in Add-Type's default reference set, and the compiled assembly
    only ever loads inside a pwsh process where SMA is loaded by definition (ADR native-csharp-types,
    "host-guaranteed assemblies"). There is no NuGet in this toolset, so the IDE build mirrors that
    contract the same way the runtime satisfies it: ask the pwsh on PATH for the SMA assembly it actually
    loads ([psobject].Assembly.Location — deliberately $-free so the command survives both cmd and sh)
    and reference it compile-time-only (Private=false, never copied to output).
  -->
  <Target Name="ResolveSmaReferenceFromPwshHost" BeforeTargets="ResolveAssemblyReferences">
    <Exec Command="pwsh -NoProfile -NonInteractive -Command &quot;[Console]::Out.Write([psobject].Assembly.Location)&quot;"
          ConsoleToMSBuild="true" EchoOff="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="CatzcSmaPath" />
      <Output TaskParameter="ExitCode" PropertyName="CatzcPwshExitCode" />
    </Exec>
    <Error Condition="'$(CatzcPwshExitCode)' != '0' Or !Exists('$(CatzcSmaPath)')"
           Text="Catzc.Types: could not resolve System.Management.Automation.dll from the pwsh on PATH (exit $(CatzcPwshExitCode), path '$(CatzcSmaPath)'). The IDE build references SMA from the PowerShell 7 host (no NuGet in this toolset) — install pwsh 7.4+ and ensure it is on PATH." />
    <ItemGroup>
      <Reference Include="System.Management.Automation">
        <HintPath>$(CatzcSmaPath)</HintPath>
        <!-- Compile-time-only: the host supplies SMA at runtime, so it is never copied to output. -->
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>

  <!--
    Stamp this project's version from the sources' identity. The RUNTIME (Import-CSharpTypes) writes
    pwsh/.compiled/Catzc.Types.<hash>.dll, where <hash> is the combined hash of every module's
    types/*.cs (ADR caching, [ADR-AUTO-CACHE-COMPILEDTYPEPREBUILD](/docs/adr/automation/caching.md#rule-adr-auto-cache-compiledtypeprebuild)) — that
    hash IS the assembly's identity. The task computes
    the same hash from the sources with the SAME algorithm the loader uses (per file: SHA-256 of the bytes with
    every CR (0x0D) stripped, upper-hex; one line "<module>/<type>|<upper-hex>\n" per file in ordinal
    <module>/<type> order; SHA-256 of that text; first 8 hex, lower-cased) and stamps it, so the IDE build's
    version mirrors the runtime artifact (deps.json -> "Catzc.Types/1.0.0-<hash>"). Deterministic: the same
    sources always give the same version, whatever else lies on disk. The algorithm mirrors Import-CSharpTypes /
    Clear-ModuleTypeCache / the drift-guard tests and MUST stay in sync.

    The editor never fails over pwsh/.compiled: whether the code compiles is the editor's question, and
    the committed assembly is the importer's, the tests' and the bundle check's. It only WARNS when what git
    will commit — the index's pwsh/.compiled, not the disk — does not hold exactly one
    Catzc.Types.<hash>.dll named for the current sources. Untracked or unstaged leftovers (an old build another
    pwsh still has loaded) never matter. Dot-source ./importer.ps1 and stage pwsh/.compiled when it warns.
  -->
  <UsingTask TaskName="StampCatzcTypesVersion" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ModulesRoot ParameterType="System.String" Required="true" />
      <!-- The index's pwsh/.compiled entries (git ls-files), ';'-separated; empty when git is unavailable. -->
      <TrackedCompiled ParameterType="System.String" Required="false" />
      <GitAvailable ParameterType="System.Boolean" Required="false" />
      <CombinedHash ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Gather pwsh/<module>/types/*.cs (skip dot-modules), keyed <module>/<bare-type>.
        var files = new List<KeyValuePair<string, string>>();
        foreach (var moduleDir in Directory.EnumerateDirectories(ModulesRoot))
        {
            var module = Path.GetFileName(moduleDir);
            if (module.StartsWith(".")) continue;
            var typesDir = Path.Combine(moduleDir, "types");
            if (!Directory.Exists(typesDir)) continue;
            foreach (var cs in Directory.EnumerateFiles(typesDir, "*.cs"))
            {
                var bare = Path.GetFileNameWithoutExtension(cs);
                files.Add(new KeyValuePair<string, string>(module + "/" + bare, cs));
            }
        }
        files.Sort((a, b) => string.CompareOrdinal(a.Key, b.Key));

        string sourceHash;
        using (var sha = System.Security.Cryptography.SHA256.Create())
        {
            var sb = new StringBuilder();
            foreach (var f in files)
            {
                var raw = File.ReadAllBytes(f.Value);
                var norm = new List<byte>(raw.Length);
                foreach (var b in raw) if (b != 13) norm.Add(b);   // EOL-insensitive: strip CR (0x0D)
                var fileHex = BitConverter.ToString(sha.ComputeHash(norm.ToArray())).Replace("-", "");
                sb.Append(f.Key).Append('|').Append(fileHex).Append('\n');
            }
            var combined = sha.ComputeHash(Encoding.UTF8.GetBytes(sb.ToString()));
            sourceHash = BitConverter.ToString(combined).Replace("-", "").Substring(0, 8).ToLowerInvariant();
        }

        CombinedHash = sourceHash;   // the stamp is the sources' identity, never a file on disk

        // Commit hygiene, as a warning only: what the index will commit must be exactly the current build.
        if (GitAvailable)
        {
            var tracked = new List<string>();
            foreach (var entry in (TrackedCompiled ?? string.Empty).Split(';'))
            {
                var name = Path.GetFileName(entry.Trim());
                if (name.StartsWith("Catzc.Types.") && name.EndsWith(".dll")) tracked.Add(name);
            }
            var expected = "Catzc.Types." + sourceHash + ".dll";
            if (tracked.Count != 1 || tracked[0] != expected)
            {
                var found = tracked.Count == 0 ? "none" : string.Join(", ", tracked);
                Log.LogWarning("Catzc.Types: the git index's .compiled holds " + found + ", but a commit of "
                    + "these sources needs exactly " + expected + ". Dot-source ./importer.ps1, then stage "
                    + ".compiled in the modules folder (the editor build itself is unaffected).");
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- Run before anything reads $(Version): PrepareForBuild precedes GetAssemblyVersion (assembly
       attributes) and GenerateBuildDependencyFile (the deps.json project entry). -->
  <Target Name="StampCatzcTypesVersionFromSources" BeforeTargets="PrepareForBuild;GetAssemblyVersion;GenerateBuildDependencyFile">
    <!-- What the index will commit under pwsh/.compiled. No git (or not a work tree): no hygiene warning. -->
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)/../..&quot; ls-files -- .compiled"
          ConsoleToMSBuild="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" ItemName="CatzcTrackedCompiled" />
      <Output TaskParameter="ExitCode" PropertyName="CatzcGitExitCode" />
    </Exec>
    <StampCatzcTypesVersion ModulesRoot="$(MSBuildProjectDirectory)/../.." TrackedCompiled="@(CatzcTrackedCompiled)"
                            GitAvailable="$([System.String]::Equals('$(CatzcGitExitCode)', '0'))">
      <Output TaskParameter="CombinedHash" PropertyName="CatzcTypesHash" />
    </StampCatzcTypesVersion>
    <PropertyGroup>
      <Version>1.0.0-$(CatzcTypesHash)</Version>
      <InformationalVersion>$(CatzcTypesHash)</InformationalVersion>
    </PropertyGroup>
    <!-- Normal importance: a stamp that matches is routine and stays out of the editor's Problems view; only the
         commit-hygiene warning above is meant to be seen. A verbose build (-v n) still shows it. -->
    <Message Importance="normal" Text="Catzc.Types: stamped version $(Version) from the source hash $(CatzcTypesHash)." />
  </Target>

</Project>
