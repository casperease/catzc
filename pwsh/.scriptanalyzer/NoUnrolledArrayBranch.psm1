Set-StrictMode -Version Latest   # this module's scope: the rule runs strict inside the analyzer engine

function Measure-NoUnrolledArrayBranch {
    <#
    .SYNOPSIS
        Flags a variable assigned an if statement whose branch yields a bare array expression, which the assignment unrolls.

    .DESCRIPTION
        A statement assigned to a variable yields its output, unwrapped: an @(...) in a branch of `$x = if (...) { @(...) }` gives $null
        for no item and the item itself for one, so a later $x.Count throws under strict mode
        ([ADR-PWSH-ERROR-STRICTCLEAN](/docs/drs/automation/pwsh/error-handling.md#rule-adr-pwsh-error-strictclean)). The fix is to wrap
        the whole statement, `$x = @(if (...) { ... })`.
    #>
    [CmdletBinding()]
    [OutputType([Microsoft.Windows.PowerShell.ScriptAnalyzer.Generic.DiagnosticRecord[]])]
    param(
        [Parameter(Mandatory)]
        [ValidateNotNullOrEmpty()]
        [System.Management.Automation.Language.ScriptBlockAst] $ScriptBlockAst
    )

    $results = [System.Collections.Generic.List[Microsoft.Windows.PowerShell.ScriptAnalyzer.Generic.DiagnosticRecord]]::new()

    $isIfAssignment = {
        param($node)
        $node -is [System.Management.Automation.Language.AssignmentStatementAst] -and
        $node.Operator -eq [System.Management.Automation.Language.TokenKind]::Equals -and
        $node.Right -is [System.Management.Automation.Language.IfStatementAst]
    }

    $isBareArray = {
        param($statement)
        $statement -is [System.Management.Automation.Language.PipelineAst] -and
        $statement.PipelineElements.Count -eq 1 -and
        $statement.PipelineElements[0] -is [System.Management.Automation.Language.CommandExpressionAst] -and
        $statement.PipelineElements[0].Expression -is [System.Management.Automation.Language.ArrayExpressionAst]
    }

    foreach ($assignment in $ScriptBlockAst.FindAll($isIfAssignment, $true)) {
        $blocks = @($assignment.Right.Clauses | ForEach-Object { $_.Item2 })
        if ($assignment.Right.ElseClause) {
            $blocks += $assignment.Right.ElseClause
        }
        $unrolled = $false
        foreach ($block in $blocks) {
            foreach ($statement in $block.Statements) {
                if (& $isBareArray $statement) {
                    $unrolled = $true
                }
            }
        }
        if ($unrolled) {
            $results.Add([Microsoft.Windows.PowerShell.ScriptAnalyzer.Generic.DiagnosticRecord]@{
                    Message  = "The assigned if statement yields a bare @(...) in a branch, which the assignment unrolls: no item gives `$null and one item the item itself, so '.Count' throws under strict mode. Wrap the statement, '`$x = @(if (...) { ... })' (ADR-PWSH-ERROR-STRICTCLEAN)."
                    Extent   = $assignment.Extent
                    RuleName = 'Measure-NoUnrolledArrayBranch'
                    Severity = 'Warning'
                })
        }
    }

    return $results.ToArray()
}

Export-ModuleMember -Function Measure-*
