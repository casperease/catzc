# ---
# catzc:
#   derived:
#     path: ".gitignore"
#     source:
#       - automation/Catzc.Base.Git/configs/gitignore.yml
#       - automation/Catzc.Base.RootConfig/configs/rootconfig.yml
#     kind: tracked-generated-from-source
#     generator: automation/Catzc.Base.Git/New-GitIgnore.ps1
# ---

# ── Local, never-committed files ────────────────────────────────────────────────────────────────────────────────────
# Per-machine working files: local agent instructions, settings and MCP wiring, scratch folders, editor backups, and
# the occasional bash-on-Windows crash dump.
.claude/CLAUDE.local.md
.claude/settings.local.json
.mcp.json
tmp
*.bkp
*.dtmp
bash.exe.stackdump

# ── Output directory ────────────────────────────────────────────────────────────────────────────────────────────────
# All generated artifacts land in out/ (see docs/adr/repository/dedicated-output-directory.md). The folder itself is
# kept so a fresh checkout has the anchor; its contents never enter git.
out/*
# keep the folder, ignore its contents
!out/.gitkeep

# ── Rendered PDFs ───────────────────────────────────────────────────────────────────────────────────────────────────
# A PDF is rendered from a source, so it is output (docs/adr/repository/dedicated-output-directory.md, rule 11):
# ignored everywhere. A PDF that must be committed opts out here with its own '!' line and a note saying why.
*.pdf

# ── Generated module manifests ──────────────────────────────────────────────────────────────────────────────────────
# Every module's <Module>.psd1 is generated by the loader on import (open-closed architecture) — derived, never
# committed. Vendored third-party modules ship their own authored manifests, and the authored analyzer config under
# .internal/assets is a config file that merely shares the extension, so both opt back in past the glob.
automation/**/*.psd1
# vendored modules ship their own manifests
!automation/.vendor/**/*.psd1
# authored analyzer source
!automation/.internal/assets/PSScriptAnalyzerSettings.psd1

# ── Managed root-config copies ──────────────────────────────────────────────────────────────────────────────────────
# Repository-root config files fully managed by Catzc.Base.RootConfig — each reproduced on import from its one in-repo
# source of truth (see rootconfig.yml). Edit the source, never the root copy; this list is injected from the
# registry's committed:false targets and never restated by hand.
/PSScriptAnalyzerSettings.psd1
/.vscode/settings.json
/.vscode/extensions.json
/.vscode/launch.json
/.vscode/azure-pipelines-schema.json
/go.work
/*/tests/*/go.mod
/*/pyproject.toml
/*/tests/*/pyproject.toml
/.vscode/markdown-preview-dark.css
/.editorconfig
/.markdownlint.yml
/.markdownlintignore
/.prettierrc.yml
/.prettierignore
/.cspell/.gitignore
/cspell.yml
/dotnet-tools.json
/catzc.sln

# ── Generated READMEs ───────────────────────────────────────────────────────────────────────────────────────────────
# A README.md in a mapped conventional folder is a generated copy of an authored docs source (Build-Readme,
# Catzc.Base.Docs; see docs/adr/repository/generated-readmes.md) — derived artifacts like the module manifests,
# regenerated on every import. Hand-authored READMEs are exactly the unmapped folders and opt back in below. The
# generated cspell dictionaries under .cspell/ are ignored by the folder's own managed .gitignore (a root-config
# copy), so only that folder's .gitkeep is committed.
**/README.md
!.github/README.md
!automation/.vendor/**/README.md
!automation/Catzc.Azure.Templates/tests/assets/README.md
# a contract asset named README.md pins its target; contracts/README.md stays generated
!contracts/*/**/README.md

# ── Compiled C# types — transient temp only ─────────────────────────────────────────────────────────────────────────
# The combined compiled assembly (automation/.compiled/Catzc.Types.<hash>.dll) is COMMITTED — a vendored, hash-keyed
# prebuild that lets a fresh checkout and CI load without compiling (see docs/adr/automation/caching.md). Only the
# concurrent-compile temp file is ignored.
automation/.compiled/*.tmp

# ── IDE-only C# project build output ────────────────────────────────────────────────────────────────────────────────
# The root catzc.sln references automation/.internal/assets/Catzc.Types.csproj for editor tooling, and MSBuild emits
# obj/bin next to that project. The runtime never builds it (Add-Type compiles the type sources at import), so its
# MSBuild artifacts are transient and vscode consumed only. The automation types system builds via the internal
# builder, no csproj or sln involved.
automation/.internal/assets/obj/
automation/.internal/assets/bin/

# ── Agent hook build output ─────────────────────────────────────────────────────────────────────────────────────────
# The Claude Code Bash time-safeguard hook is a small C# program (.claude/hooks/Assert-BashTimeout/) that
# Build-BashTimeoutHook publishes on import whenever its source changes. The published program and its MSBuild
# intermediates are per-machine build output, rebuilt from the committed source.
.claude/hooks/bin/
.claude/hooks/Assert-BashTimeout/obj/
.claude/hooks/Assert-BashTimeout/bin/

# ── Go test workspace sums ──────────────────────────────────────────────────────────────────────────────────────────
# The Go test workspace is generated (ADR-AUTO-GO): go.work and each go.mod are managed root-config copies, ignored
# through their rootconfig entries. The checksum files go writes beside them when the Go test bridge downloads modules
# are per-machine output, never committed.
/go.work.sum
/*/tests/*/go.sum

# ── Python test environment ─────────────────────────────────────────────────────────────────────────────────────────
# The Python test workspace is generated (ADR-AUTO-PY): its pyproject.toml files are managed root-config copies,
# ignored through their rootconfig entries. The one environment and lock uv makes beside the workspace root in the
# Python root (python/ or .python/), and the linter's and bytecode caches, are per-machine output, never committed.
/*/.venv/
/*/uv.lock
.ruff_cache/
__pycache__/
